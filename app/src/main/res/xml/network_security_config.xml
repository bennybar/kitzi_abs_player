<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is allowed everywhere: Audiobookshelf is self-hosted, and a server
         on the LAN at http://192.168.x.x:13378 is a common setup. Only localhost was
         allowed before, so those servers failed with a generic "sign in failed".
         An address typed without a scheme still defaults to https. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
